DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Hashes SHA-256 de cédulas válidas que deban exceptuarse del checksum Luhn.
# Mantener vacío salvo que exista una excepción documentada y autorizada.
CEDULA_LUHN_EXCEPTION_HASHES=

# sqlite | sqlserver
DATABASE_ENGINE=sqlite

# SQL Server
DB_NAME=CineGestDb
DB_USER=sa
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes;Encrypt=yes
